<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_principal"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="36dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <Button
            android:id="@+id/btnVolver"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_boton_azul"
            android:backgroundTint="@color/azul_principal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/volver"
            android:textAllCaps="false"
            android:textColor="@color/texto_sobre_azul"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mis_tareas"
            android:textColor="@color/azul_oscuro"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/mis_tareas_subtitulo_avance05"
            android:textColor="@color/texto_secundario"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/txtSinTareas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:padding="18dp"
            android:text="@string/sin_tareas"
            android:textColor="@color/texto_secundario"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/contenedorTareas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnAgregarDesdeLista"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_boton_amarillo"
            android:backgroundTint="@color/amarillo_principal"
            android:text="@string/agregar_tarea_mas"
            android:textAllCaps="false"
            android:textColor="@color/texto_boton_amarillo"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:padding="14dp"
            android:text="@string/nota_memoria_temporal"
            android:textColor="@color/texto_secundario"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
