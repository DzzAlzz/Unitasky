<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_principal"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="38dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_boton_azul"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <ImageView
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:contentDescription="@string/logo_description"
                android:src="@drawable/ic_unitasky_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bienvenido_unitasky"
                    android:textColor="@color/texto_sobre_azul"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/inicio_subtitulo"
                    android:textColor="@color/azul_claro"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/accesos_rapidos"
            android:textColor="@color/texto_principal"
            android:textSize="19sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMisTareas"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_opcion"
            android:backgroundTint="@color/azul_claro"
            android:gravity="start|center_vertical"
            android:paddingStart="20dp"
            android:text="@string/mis_tareas"
            android:textAllCaps="false"
            android:textColor="@color/azul_oscuro"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAgregarTarea"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_boton_amarillo"
            android:backgroundTint="@color/amarillo_principal"
            android:gravity="start|center_vertical"
            android:paddingStart="20dp"
            android:text="@string/agregar_tarea"
            android:textAllCaps="false"
            android:textColor="@color/texto_boton_amarillo"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnProximasEntregas"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_opcion"
            android:backgroundTint="@color/azul_claro"
            android:gravity="start|center_vertical"
            android:paddingStart="20dp"
            android:text="@string/proximas_entregas"
            android:textAllCaps="false"
            android:textColor="@color/azul_oscuro"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/inicio_nota"
            android:textColor="@color/texto_secundario"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
