<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_principal"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="28dp"
        android:paddingEnd="22dp"
        android:paddingBottom="32dp">

        <Button
            android:id="@+id/btnVolver"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_boton_azul"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/volver"
            android:textAllCaps="false"
            android:textColor="@color/texto_sobre_azul"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_seccion_clara"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mis_asignaturas"
                android:textColor="@color/azul_oscuro"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/mis_asignaturas_subtitulo"
                android:textColor="@color/texto_secundario"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtSinAsignaturas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:padding="22dp"
            android:text="@string/sin_asignaturas"
            android:textColor="@color/texto_secundario"
            android:textSize="15sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/contenedorAsignaturas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnAgregarAsignatura"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_boton_amarillo"
            android:text="@string/agregar_asignatura"
            android:textAllCaps="false"
            android:textColor="@color/texto_boton_amarillo"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
