<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_principal"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="36dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/agregar_tarea"
            android:textColor="@color/azul_oscuro"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/agregar_tarea_subtitulo"
            android:textColor="@color/texto_secundario"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titulo_tarea"
                android:textColor="@color/texto_principal"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtTituloTarea"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_input"
                android:hint="@string/titulo_tarea_hint"
                android:inputType="textCapSentences"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/descripcion_tarea"
                android:textColor="@color/texto_principal"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtDescripcionTarea"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_input"
                android:gravity="top|start"
                android:hint="@string/descripcion_tarea_hint"
                android:inputType="textMultiLine"
                android:padding="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/fecha_entrega"
                android:textColor="@color/texto_principal"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtFechaTarea"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_input"
                android:hint="@string/fecha_hint"
                android:inputType="date"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/prioridad"
                android:textColor="@color/texto_principal"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerPrioridad"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/estado_tarea"
                android:textColor="@color/texto_principal"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerEstado"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <Button
                android:id="@+id/btnGuardarTarea"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_boton_amarillo"
                android:backgroundTint="@color/amarillo_principal"
                android:text="@string/guardar_tarea"
                android:textAllCaps="false"
                android:textColor="@color/texto_boton_amarillo"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
