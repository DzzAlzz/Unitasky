<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_principal"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="28dp"
        android:paddingEnd="22dp"
        android:paddingBottom="32dp">

        <Button
            android:id="@+id/btnVolverHistorialEnfoque"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_opcion"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/volver"
            android:textAllCaps="false"
            android:textColor="@color/azul_oscuro"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_encabezado"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/historial_enfoque_titulo"
                android:textColor="@color/azul_oscuro"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtHistorialTarea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/historial_enfoque_tarea_sin_nombre"
                android:textColor="@color/texto_secundario"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/historial_enfoque_total_titulo"
                android:textColor="@color/texto_secundario"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtHistorialTiempoTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/historial_enfoque_total_inicial"
                android:textColor="@color/azul_oscuro"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtHistorialVacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:padding="20dp"
            android:text="@string/historial_enfoque_vacio"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/contenedorSesionesEnfoque"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/historial_enfoque_nota_avance22"
            android:textColor="@color/texto_secundario"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
